# Exemple de configuration de ha-gazpar, au format du fichier de configuration
# (docs/MANUEL.md §4.4). Copiez-le par exemple en ha-gazpar.conf (ou en .env,
# ignoré par Git, pour le développement) et désignez-le avec --config ou
# GAZPAR_CONFIG. Ce n'est pas un fichier .env de Docker : ne le passez ni en
# env_file: ni en --env-file.
# Valeurs factices. Une valeur vide compte comme absente.
#
# Ce fichier respecte aussi le format du fichier de configuration
# (docs/MANUEL.md §4.4) : `ha-gazpar check --config .env` le lit tel quel.
# Pas de commentaire en fin de ligne, pas de `export`.

# --- Requis ---

# Compte Mon Espace GRDF.
GRDF_USERNAME=prenom.nom@example.org
GRDF_PASSWORD=mot-de-passe-factice
# Point de comptage et d'estimation : 14 chiffres.
GRDF_PCE=12345678901234

# Home Assistant : ws://hôte:port, le chemin /api/websocket est ajouté s'il
# manque (wss:// non pris en charge).
HA_URL=ws://127.0.0.1:8124
# Jeton d'accès longue durée d'un utilisateur Home Assistant dédié.
HA_TOKEN=jeton-factice

# Variantes fichier (secrets Docker ou systemd) : chemin absolu d'un fichier
# dont l'espace final est retiré. Ne pas définir les deux formes à la fois.
# GRDF_USERNAME_FILE=/run/secrets/grdf_username
# GRDF_PASSWORD_FILE=/run/secrets/grdf_password
# GRDF_PCE_FILE=/run/secrets/grdf_pce
# HA_TOKEN_FILE=/run/secrets/ha_token

# --- Facultatif (valeurs par défaut) ---

# Minutes entre deux relevés, minimum 60.
GAZPAR_SCAN_INTERVAL=480
# Profondeur du premier import, en jours (1 à 3650).
GAZPAR_HISTORY_DAYS=1095
# Fenêtre de rattrapage relue à chaque relevé, en jours (1 à 60).
GAZPAR_OVERLAP_DAYS=14
# Préfixe des statistiques : gazpar donne gazpar:<pce>_energy et gazpar:<pce>_volume ;
# sensor.gazpar2haws reprend sensor.gazpar2haws_energy et sensor.gazpar2haws_volume.
GAZPAR_STATISTIC_PREFIX=gazpar
# info ou debug.
GAZPAR_LOG_LEVEL=info

# --- Développement uniquement : variables d'environnement seulement (pas dans
# le fichier de configuration), vers localhost ou 127.0.0.1 seulement ---
# GRDF_BASE_URL=http://127.0.0.1:8080
# GRDF_LOGIN_URL=http://127.0.0.1:8081
