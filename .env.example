# Configuration locale de ha-gazpar (copier en .env, ignoré par Git).
# Valeurs factices. Une variable vide compte comme absente.

# --- Requis ---

# Compte Mon Espace GRDF.
GRDF_USERNAME=prenom.nom@example.org
GRDF_PASSWORD=mot-de-passe-factice
# Point de comptage et d'estimation : 14 chiffres.
GRDF_PCE=12345678901234

# API WebSocket de Home Assistant (ws:// uniquement, wss:// non pris en charge).
HA_URL=ws://127.0.0.1:8124/api/websocket
# Jeton d'accès longue durée d'un utilisateur Home Assistant dédié.
HA_TOKEN=jeton-factice

# Variantes fichier (secrets Docker) : chemin d'un fichier dont l'espace final
# est retiré. Ne pas définir les deux formes à la fois.
# GRDF_USERNAME_FILE=/run/secrets/grdf_username
# GRDF_PASSWORD_FILE=/run/secrets/grdf_password
# GRDF_PCE_FILE=/run/secrets/grdf_pce
# HA_TOKEN_FILE=/run/secrets/ha_token

# --- Facultatif (valeurs par défaut) ---

# Minutes entre deux relevés, minimum 60.
GAZPAR_SCAN_INTERVAL=480
# Profondeur du premier import, en jours (1 à 3650).
GAZPAR_HISTORY_DAYS=1095
# Fenêtre de rattrapage relue à chaque relevé, en jours (1 à 60).
GAZPAR_OVERLAP_DAYS=14
# informative (un relevé par jour) ou published.
GAZPAR_CONSUMPTION_TYPE=informative
# Fuseau des jours gaziers.
GAZPAR_TIMEZONE=Europe/Paris
# Préfixe des statistiques : gazpar donne gazpar:<pce>_energy et gazpar:<pce>_volume ;
# sensor.gazpar2haws reprend sensor.gazpar2haws_energy et sensor.gazpar2haws_volume.
GAZPAR_STATISTIC_PREFIX=gazpar
# info ou debug.
LOG_LEVEL=info

# --- Développement uniquement (localhost ou 127.0.0.1 seulement) ---
# GRDF_BASE_URL=http://127.0.0.1:8080
# GRDF_LOGIN_URL=http://127.0.0.1:8081
